    def advanced_preprocessing(self, test_size=0.2, random_state=42, sampling_strategy='auto'):
        """Enhanced preprocessing with detailed progress tracking"""
        if self.data is None:
            print("❌ No data loaded. Please load data first.")
            return

        print("\n" + "="*80)
        print("⚙️ ADVANCED DATA PREPROCESSING")
        print("="*80)

        # Progress tracking
        steps = ["Feature Engineering", "Scaling", "Feature Selection", "Train-Test Split", "Resampling"]
        current_step = 0

        def update_progress(step_name):
            nonlocal current_step
            current_step += 1
            print(f"🔹 [{current_step}/{len(steps)}] {step_name}...")

        update_progress("Feature Engineering")
        # Feature engineering (same as before)
        if 'Time' in self.data.columns:
            self.data['Hour'] = (self.data['Time'] % (24*3600)) / 3600
            self.data['Day'] = (self.data['Time'] // (24*3600)) % 7
            self.data['Hour_sin'] = np.sin(2 * np.pi * self.data['Hour']/24)
            self.data['Hour_cos'] = np.cos(2 * np.pi * self.data['Hour']/24)
            self.data['Day_sin'] = np.sin(2 * np.pi * self.data['Day']/7)
            self.data['Day_cos'] = np.cos(2 * np.pi * self.data['Day']/7)
            X = self.data.drop(['Class', 'Time', 'Hour', 'Day'], axis=1)
        else:
            X = self.data.drop(['Class'], axis=1)

        y = self.data['Class']

        update_progress("Scaling and Transformation")
        # Advanced preprocessing pipeline
        preprocessor = Pipeline([
            ('scaler', RobustScaler()),
            ('power_transform', PowerTransformer(method='yeo-johnson')),
            ('feature_selection', SelectKBest(f_classif, k=20))
        ])

        X_processed = preprocessor.fit_transform(X, y)
        self.scaler = preprocessor.named_steps['scaler']
        self.feature_selector = preprocessor.named_steps['feature_selection']

        selected_features = X.columns[preprocessor.named_steps['feature_selection'].get_support()]
        X_processed_df = pd.DataFrame(X_processed, columns=selected_features)

        update_progress("Train-Test Split")
        # Split data
        self.X_train, self.X_test, self.y_train, self.y_test = train_test_split(
            X_processed_df, y, test_size=test_size, random_state=random_state, stratify=y)

        update_progress("Resampling")
        # Handle class imbalance
        smote = SMOTE(sampling_strategy=0.1, random_state=random_state)
        under = RandomUnderSampler(sampling_strategy=0.5, random_state=random_state)
        pipeline = ImbPipeline(steps=[('over', smote), ('under', under)])
        self.X_train, self.y_train = pipeline.fit_resample(self.X_train, self.y_train)

        # Enhanced results display
        display(HTML(f"""
        <div style="background-color:#e8f5e8; padding:15px; border-radius:10px; border-left:5px solid #4CAF50;">
            <h3 style="color:#2E7D32;">✅ Preprocessing Complete</h3>
            <p><strong>Training Set:</strong> {self.X_train.shape[0]:,} samples</p>
            <p><strong>Test Set:</strong> {self.X_test.shape[0]:,} samples</p>
            <p><strong>Selected Features:</strong> {len(selected_features)} out of {X.shape[1]}</p>
            <p><strong>Class Distribution After Resampling:</strong></p>
            <p>Normal: {sum(self.y_train == 0):,} | Fraud: {sum(self.y_train == 1):,}</p>
        </div>
        """))

        self.X = X_processed_df
        self.y = y

        # Display selected features
        print("\n🎯 Top 10 Selected Features:")
        feature_scores = preprocessor.named_steps['feature_selection'].scores_
        feature_df = pd.DataFrame({
            'Feature': selected_features,
            'Importance_Score': feature_scores[preprocessor.named_steps['feature_selection'].get_support()]
        }).sort_values('Importance_Score', ascending=False).head(10)

        display(HTML(feature_df.to_html(classes='table table-hover', index=False)))

    def _get_stacking_classifier(self):
        """Create a stacking classifier with available models"""
        estimators = [
            ('xgb', XGBClassifier(learning_rate=0.01, n_estimators=100, random_state=42)),
            ('lgbm', LGBMClassifier(learning_rate=0.01, n_estimators=100, random_state=42, verbose=-1)),
            ('rf', RandomForestClassifier(n_estimators=100, random_state=42))
        ]

        return StackingClassifier(
            estimators=estimators,
            final_estimator=LogisticRegression(),
            cv=5
        )

    def train_enhanced_models(self):
        """Enhanced model training with real-time progress tracking"""
        if self.X_train is None or self.y_train is None:
            print("❌ Data not preprocessed. Please run advanced_preprocessing() first.")
            return

        print("\n" + "="*80)
        print("🤖 TRAINING ENHANCED MODELS")
        print("="*80)

        # Enhanced model configurations (only use available models)
        models = {
            'XGBoost': XGBClassifier(
                learning_rate=0.01, n_estimators=1000, max_depth=5,
                objective='binary:logistic', scale_pos_weight=100, random_state=42
            ),
            'LightGBM': LGBMClassifier(
                learning_rate=0.01, n_estimators=1000, num_leaves=31,
                class_weight='balanced', random_state=42, verbose=-1
            ),
            'Random Forest': RandomForestClassifier(
                n_estimators=500, max_depth=10, class_weight='balanced_subsample',
                random_state=42, n_jobs=-1
            ),
            'Stacking Ensemble': self._get_stacking_classifier()
        }

        # Add CatBoost only if available
        if CATBOOST_AVAILABLE:
            models['CatBoost'] = CatBoostClassifier(
                iterations=1000, learning_rate=0.01, depth=6,
                auto_class_weights='Balanced', random_state=42, verbose=0
            )

        # Training progress visualization
        fig = go.Figure()
        results = []

        for i, (name, model) in enumerate(models.items()):
            print(f"\n🎯 Training {name}...")
            start_time = time.time()

            try:
                # Train model
                model.fit(self.X_train, self.y_train)
                training_time = time.time() - start_time

                # Predictions
                y_pred = model.predict(self.X_test)
                y_pred_proba = model.predict_proba(self.X_test)[:, 1]

                # Enhanced metrics calculation
                accuracy = accuracy_score(self.y_test, y_pred)
                precision = precision_score(self.y_test, y_pred)
                recall = recall_score(self.y_test, y_pred)
                f1 = f1_score(self.y_test, y_pred)

                # Specificity (True Negative Rate)
                tn = confusion_matrix(self.y_test, y_pred)[0, 0]
                fp = confusion_matrix(self.y_test, y_pred)[0, 1]
                specificity = tn / (tn + fp) if (tn + fp) > 0 else 0

                # F2 Score (emphasizes recall)
                f2_score_val = (5 * precision * recall) / (4 * precision + recall) if (precision + recall) > 0 else 0

                # AUC scores
                fpr, tpr, _ = roc_curve(self.y_test, y_pred_proba)
                roc_auc = auc(fpr, tpr)
                precision_curve, recall_curve, _ = precision_recall_curve(self.y_test, y_pred_proba)
                pr_auc = auc(recall_curve, precision_curve)

                # Store results
                results.append({
                    'Model': name, 'Accuracy': accuracy, 'Precision': precision,
                    'Recall': recall, 'F1': f1, 'ROC AUC': roc_auc, 'PR AUC': pr_auc,
                    'Training Time': training_time, 'Specificity': specificity, 'F2_Score': f2_score_val
                })

                # Enhanced model evaluation display
                self._display_model_performance(name, accuracy, precision, recall, f1,
                                              roc_auc, pr_auc, training_time, specificity, f2_score_val)

            except Exception as e:
                print(f"❌ Error training {name}: {e}")
                continue

        # Update performance DataFrame
        self.models_performance = pd.DataFrame(results)

        if not self.models_performance.empty:
            # Select best model
            best_model_idx = self.models_performance['F1'].idxmax()
            self.best_model = models[self.models_performance.loc[best_model_idx, 'Model']]
            self.model_name = self.models_performance.loc[best_model_idx, 'Model']

            # Final best model announcement
            best_metrics = self.models_performance.loc[best_model_idx]
            display(HTML(f"""
            <div style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        color:white; padding:20px; border-radius:15px; text-align:center;">
                <h2>🏆 BEST MODEL SELECTED: {self.model_name}</h2>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px;">
                    <div style="background:rgba(255,255,255,0.2); padding:10px; border-radius:8px;">
                        <h4>Accuracy</h4>
                        <h3>{best_metrics['Accuracy']:.4f}</h3>
                    </div>
                    <div style="background:rgba(255,255,255,0.2); padding:10px; border-radius:8px;">
                        <h4>F1 Score</h4>
                        <h3>{best_metrics['F1']:.4f}</h3>
                    </div>
                    <div style="background:rgba(255,255,255,0.2); padding:10px; border-radius:8px;">
                        <h4>ROC AUC</h4>
                        <h3>{best_metrics['ROC AUC']:.4f}</h3>
                    </div>
                </div>
            </div>
            """))
        else:
            print("❌ No models were successfully trained.")

