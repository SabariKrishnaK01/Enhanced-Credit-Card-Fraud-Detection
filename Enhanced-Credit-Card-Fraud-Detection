    def predict_fraud(self, transaction_data):
        """Predict fraud probability for a transaction"""
        if self.best_model is None:
            print("❌ No model trained. Please train a model first.")
            return None, None, None

        try:
            prediction = self.best_model.predict(transaction_data)[0]
            probability = self.best_model.predict_proba(transaction_data)[0, 1]

            # Determine risk level
            if probability >= 0.7:
                risk_level = "High"
            elif probability >= 0.3:
                risk_level = "Medium"
            else:
                risk_level = "Low"

            return prediction, probability, risk_level
        except Exception as e:
            print(f"❌ Error making prediction: {e}")
            return None, None, None

    def save_model(self, filepath):
        """Save the trained model to a file"""
        if self.best_model is None:
            print("❌ No model to save. Please train a model first.")
            return False

        try:
            with open(filepath, 'wb') as f:
                pickle.dump({
                    'model': self.best_model,
                    'model_name': self.model_name,
                    'scaler': self.scaler,
                    'feature_selector': self.feature_selector
                }, f)
            print(f"✅ Model saved successfully to {filepath}")
            return True
        except Exception as e:
            print(f"❌ Error saving model: {e}")
            return False

    def real_time_detection_system(self, num_transactions=10):
        """Enhanced real-time fraud detection with beautiful alerts"""
        if self.best_model is None:
            print("❌ No model loaded. Please load or train a model first.")
            return

        print("\n" + "="*80)
        print("🔍 ENHANCED REAL-TIME FRAUD DETECTION SYSTEM")
        print("="*80)

        sample_indices = np.random.choice(len(self.X_test), num_transactions, replace=False)
        results = []

        for idx in sample_indices:
            transaction = self.X_test.iloc[idx:idx+1]
            actual_class = self.y_test.iloc[idx]
            prediction, probability, risk_level = self.predict_fraud(transaction)

            if prediction is None:
                continue

            # Enhanced alert system
            alert_emoji = "🚨" if risk_level == "High" else "⚠️" if risk_level == "Medium" else "✅"
            alert_color = "#dc3545" if risk_level == "High" else "#ffc107" if risk_level == "Medium" else "#28a745"

            result = {
                'Transaction_ID': idx,
                'Amount': f"${transaction['Amount'].values[0]:.2f}" if 'Amount' in transaction.columns else 'N/A',
                'Prediction': 'Fraud' if prediction == 1 else 'Normal',
                'Probability': f"{probability:.4f}",
                'Risk_Level': risk_level,
                'Actual': 'Fraud' if actual_class == 1 else 'Normal',
                'Status': 'Correct' if prediction == actual_class else 'Incorrect',
                'Alert': alert_emoji
            }
            results.append(result)

            # Enhanced transaction alert display
            display(HTML(f"""
            <div style="border:2px solid {alert_color}; border-radius:10px; padding:15px; margin:10px 0;
                        background:linear-gradient(135deg, #f8f9fa, white);">
                <div style="display: flex; justify-content: between; align-items: center;">
                    <h4 style="margin:0; color:{alert_color};">{alert_emoji} Transaction #{idx}</h4>
                    <span style="background:{alert_color}; color:white; padding:5px 10px; border-radius:15px;">
                        {risk_level} Risk
                    </span>
                </div>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 10px;">
                    <div><strong>Amount:</strong> {result['Amount']}</div>
